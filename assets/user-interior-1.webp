<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="description" content="VeroSpace — premium interior design and renovation for distinctive homes.">
  <meta name="theme-color" content="#f7f3ec">
  <title>VeroSpace — Interior Design & Renovation</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preconnect" href="https://images.unsplash.com" crossorigin>
  <link rel="preload" as="image" href="assets/user-interior-1.webp" fetchpriority="high" fetchpriority="high">
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;1,500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="styles.css">
</head>
<body>
<header class="site-header" id="top">
  <a class="brand" href="#home" aria-label="VeroSpace home">
    <span class="brand-mark"><img src="assets/verospace-logo.png" alt="" width="160" height="160"></span>
    <span class="brand-name">VeroSpace</span>
  </a>
  <div class="header-actions">
    <button class="header-consult" data-scroll="#contact">Book consultation</button>
    <button class="menu-button" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="siteMenu"><span></span><span></span></button>
  </div>
  <div class="menu-backdrop" data-menu-close></div>
  <aside class="site-menu" id="siteMenu" aria-hidden="true" aria-label="Site menu">
    <div class="menu-top"><div><span class="menu-kicker">VeroSpace</span><strong>Navigate</strong></div><button class="menu-close" type="button" aria-label="Close menu" data-menu-close>×</button></div>
    <nav class="menu-links">
      <a href="#home"><span>01</span><strong>Home</strong></a>
      <a href="#projects"><span>02</span><strong>Projects</strong></a>
      <a href="#services"><span>03</span><strong>Services</strong></a>
      <a href="#process"><span>04</span><strong>Process</strong></a>
      <a href="#contact"><span>05</span><strong>Contact</strong></a>
    </nav>
    <div class="menu-cta"><span>Start a project</span><p>Tell us the space, scope and direction. We will take it from there.</p><button class="menu-consult" data-scroll="#contact">Book consultation <b>↗</b></button></div>
  </aside>
</header>

<main>
  <section class="hero" id="home" aria-labelledby="hero-title">
    <img class="hero-image" src="assets/user-interior-1.webp" alt="Bright compact home interior with warm timber loft, kitchen and natural light" width="800" height="1000" fetchpriority="high" decoding="async">
    <div class="hero-shade" aria-hidden="true"></div>
    <div class="hero-copy">
      <p class="eyebrow light">Interior design · renovation</p>
      <h1 id="hero-title">Small spaces.<br><em>Exceptional living.</em></h1>
      <p class="hero-lede">VeroSpace turns compact homes and ambitious renovations into calm, bright spaces that feel larger, smarter and complete.</p>
      <div class="hero-actions">
        <button class="button button-light" data-scroll="#contact">Book a consultation</button>
        <button class="button button-outline" data-scroll="#projects">Explore projects</button>
      </div>
    </div>
    <div class="hero-note"><span>VeroSpace</span><small>Space planning · interiors · renovation</small></div>
  </section>

  <section class="section projects" id="projects" aria-labelledby="projects-title">
    <div class="section-head"><div><p class="eyebrow">Selected work</p><h2 id="projects-title">Five spaces. Five clear ideas.</h2></div><p>Concept portfolio studies showing how VeroSpace approaches proportion, storage, daylight and material warmth.</p></div>
    <div class="project-grid">
      <article class="project-card reveal" data-project="loftline"><div class="project-image"><img src="assets/user-interior-2.webp" alt="Bright tiny house with loft, kitchen and open stair" width="800" height="1000" loading="lazy" decoding="async"></div><div class="project-meta"><span>01 · Compact loft</span><h3>Loftline House</h3><p>Open living · loft bedroom · integrated stair</p><button class="project-open" type="button">View project ↗</button></div></article>
      <article class="project-card reveal" data-project="windowhouse"><div class="project-image"><img src="assets/user-interior-3.webp" alt="Bright narrow home with wood worktops, plants and long windows" width="800" height="1000" loading="lazy" decoding="async"></div><div class="project-meta"><span>02 · Linear living</span><h3>Window House</h3><p>Natural light · custom storage · compact kitchen</p><button class="project-open" type="button">View project ↗</button></div></article>
      <article class="project-card reveal" data-project="barnhouse"><div class="project-image"><img src="assets/user-interior-4.webp" alt="Warm cottage kitchen with sliding barn door and built-in seating" width="800" height="1000" loading="lazy" decoding="async"></div><div class="project-meta"><span>03 · Cottage renovation</span><h3>Barn House</h3><p>Kitchen renewal · sliding partition · warm oak</p><button class="project-open" type="button">View project ↗</button></div></article>
      <article class="project-card reveal" data-project="lakehouse"><div class="project-image"><img src="https://images.unsplash.com/photo-1720096004902-9954af4e2fae?auto=format&fit=crop&w=1600&q=82" alt="Bright lake-house living room with kitchen and loft ladder" width="1600" height="1067" loading="lazy" decoding="async"></div><div class="project-meta"><span>04 · Full-home refresh</span><h3>Lake House</h3><p>Living zone · kitchen connection · loft access</p><button class="project-open" type="button">View project ↗</button></div></article>
      <article class="project-card reveal" data-project="scandihouse"><div class="project-image"><img src="https://images.unsplash.com/photo-1776673688060-68433e0f7e9b?auto=format&fit=crop&w=1600&q=82" alt="Bright Scandinavian living room with soft neutral furniture and plants" width="1600" height="1067" loading="lazy" decoding="async"></div><div class="project-meta"><span>05 · Calm interior</span><h3>Scandi House</h3><p>Light palette · soft zoning · natural textures</p><button class="project-open" type="button">View project ↗</button></div></article>
    </div>
  </section>

  <section class="section services" id="services" aria-labelledby="services-title">
    <div class="section-head"><div><p class="eyebrow">Services</p><h2 id="services-title">What we shape.</h2></div><p>Fewer moving parts. Better decisions. One visual language from layout through delivery.</p></div>
    <div class="services-grid">
      <article class="service-feature reveal"><span>01</span><h3>Full interior design</h3><p>Layout, materials, furniture, lighting and styling developed as one system.</p></article>
      <article class="service-feature reveal"><span>02</span><h3>Renovation planning</h3><p>Scope, priorities, sequencing and design decisions before works begin.</p></article>
      <article class="service-feature reveal"><span>03</span><h3>Space planning</h3><p>Clear circulation, useful storage and rooms that work harder without feeling crowded.</p></article>
      <article class="service-feature reveal"><span>04</span><h3>Materials & lighting</h3><p>A restrained palette designed around daylight, warmth, durability and atmosphere.</p></article>
    </div>
  </section>

  <section class="visual-story section reveal" aria-label="Material intelligence">
    <div class="story-image"><img src="https://images.unsplash.com/photo-1749703836810-361f30aba87a?auto=format&fit=crop&w=1800&q=82" alt="Bright reading corner with white chair, plants and soft daylight" width="1800" height="1200" loading="lazy" decoding="async"></div>
    <div class="story-copy"><p class="eyebrow">Material intelligence</p><h2>Bright first.<br>Warm second.<br>Never heavy.</h2><p>We use light surfaces, natural timber, controlled contrast and layered texture so small homes stay open and calm.</p><div class="story-facts"><span>Daylight</span><span>Warm timber</span><span>Quiet storage</span></div></div>
  </section>

  <section class="section process" id="process" aria-labelledby="process-title">
    <div class="section-head"><div><p class="eyebrow">Process</p><h2 id="process-title">Five steps. No fog.</h2></div><p>A clear path from first conversation to final handover.</p></div>
    <ol class="process-list">
      <li class="reveal"><span>01</span><div><h3>Consult</h3><p>Space, goals, budget and constraints.</p></div></li>
      <li class="reveal"><span>02</span><div><h3>Plan</h3><p>Circulation, zoning, storage and priorities.</p></div></li>
      <li class="reveal"><span>03</span><div><h3>Design</h3><p>Materials, light, furniture and details.</p></div></li>
      <li class="reveal"><span>04</span><div><h3>Coordinate</h3><p>Specifications, reviews and build decisions.</p></div></li>
      <li class="reveal"><span>05</span><div><h3>Finish</h3><p>Styling, checks and final handover.</p></div></li>
    </ol>
  </section>

  <section class="principles section reveal" aria-label="VeroSpace principles">
    <div><span>01</span><h3>Space before decoration.</h3><p>Good circulation makes the whole home feel more expensive.</p></div>
    <div><span>02</span><h3>Light before drama.</h3><p>Brightness, proportion and calm materials carry the design.</p></div>
    <div><span>03</span><h3>Built for daily life.</h3><p>Storage, maintenance and comfort are part of the visual result.</p></div>
  </section>

  <section class="section more-spaces" aria-labelledby="more-title">
    <div class="section-head"><div><p class="eyebrow">More spaces</p><h2 id="more-title">A lighter direction.</h2></div><p>More references aligned with VeroSpace: bright, compact, natural and useful.</p></div>
    <div class="image-reel">
      <figure class="reveal"><img src="https://images.unsplash.com/photo-1771371428960-35a50c2d4e7c?auto=format&fit=crop&w=1600&q=82" alt="Bright modern living room with fireplace, natural wood floor and plants" width="1600" height="1067" loading="lazy" decoding="async"><figcaption>Living · clean architecture</figcaption></figure>
      <figure class="reveal"><img src="https://images.unsplash.com/photo-1722942431012-90ac0f8f3049?auto=format&fit=crop&w=1600&q=82" alt="Narrow bright kitchen and hallway with white cabinetry" width="1600" height="1067" loading="lazy" decoding="async"><figcaption>Kitchen · efficient storage</figcaption></figure>
      <figure class="reveal"><img src="https://images.unsplash.com/photo-1762529716272-b316f61502e7?auto=format&fit=crop&w=1600&q=82" alt="Bright neutral living room with natural materials and large windows" width="1600" height="1067" loading="lazy" decoding="async"><figcaption>Living · daylight and calm</figcaption></figure>
    </div>
  </section>

  <section class="contact section" id="contact" aria-labelledby="contact-title">
    <div class="contact-copy"><p class="eyebrow">Start a project</p><h2 id="contact-title">Tell us what your home should become.</h2><p>Share the essentials. We keep the first step simple and focused.</p></div>
    <form class="contact-form" id="consultationForm" novalidate>
      <label class="hp" aria-hidden="true">Website<input name="website" tabindex="-1" autocomplete="off"></label>
      <label><span>Full name</span><input name="name" autocomplete="name" required placeholder="Your name"><small data-error-for="name"></small></label>
      <label><span>Email</span><input name="email" type="email" autocomplete="email" required placeholder="you@example.com"><small data-error-for="email"></small></label>
      <label><span>Project type</span><select name="project" required><option value="">Choose one</option><option>Full-home interior design</option><option>Renovation</option><option>Kitchen / bathroom</option><option>Small-space planning</option></select><small data-error-for="project"></small></label>
      <label><span>Budget range</span><select name="budget" required><option value="">Choose one</option><option>$25k–$50k</option><option>$50k–$100k</option><option>$100k–$250k</option><option>$250k+</option></select><small data-error-for="budget"></small></label>
      <label class="full"><span>Tell us about the space</span><textarea name="message" required minlength="3" rows="5" placeholder="Property, rooms, goals, timeline..."></textarea><small data-error-for="message"></small></label>
      <div class="form-footer full"><button class="button button-dark" type="submit">Request consultation</button><p id="formStatus" role="status"></p></div>
    </form>
  </section>
</main>

<footer class="footer"><a class="footer-brand" href="#home"><img src="assets/verospace-logo.png" alt="VeroSpace" width="180" height="180"></a><nav><a href="#projects">Projects</a><a href="#services">Services</a><a href="#process">Process</a><a href="#contact">Contact</a></nav><p>VeroSpace · interior design & renovation</p></footer>

<dialog class="project-dialog" id="projectDialog">
  <button class="dialog-close" type="button" aria-label="Close project">×</button>
  <div class="dialog-media"><img id="dialogImage" src="" alt=""></div>
  <div class="dialog-copy"><p class="eyebrow">VeroSpace project</p><h2 id="dialogTitle">Project</h2><p id="dialogText"></p><dl><div><dt>Scope</dt><dd id="dialogScope"></dd></div><div><dt>Focus</dt><dd id="dialogFocus"></dd></div></dl><button class="button button-dark" data-scroll="#contact">Discuss a similar project</button></div>
</dialog>

<div class="send-overlay" id="sendOverlay" aria-hidden="true"><div class="send-card" role="status" aria-live="polite"><div class="send-mark" id="sendMark">V</div><h2 id="sendTitle">Sending…</h2><p id="sendText">Your request is being sent securely.</p></div></div>
<script src="script.js" defer></script>
</body>
</html>