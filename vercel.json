{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/api/source?file=index.html" },
    { "source": "/index.html", "destination": "/api/source?file=index.html" },
    { "source": "/native.js", "destination": "/api/source?file=native.js" },
    { "source": "/v5.css", "destination": "/api/source?file=v5.css" },
    { "source": "/v5.js", "destination": "/api/source?file=v5.js" },
    { "source": "/assets/:path*", "destination": "/api/source?file=assets/:path*" }
  ]
}
